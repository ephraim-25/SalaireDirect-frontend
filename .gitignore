# ============================================
# SalaireDirect - Frontend (.gitignore)
# Next.js / React / TypeScript / Turbopack
# ============================================

# Dépendances
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# Builds et sorties Next.js
.next/
out/
build/
dist/

# Caches et outils (Turbopack, SST, Vercel)
.turbo
.turbo/
.sst
.sst/
.vercel
.vercel/
*.tsbuildinfo
next-env.d.ts

# Variables d'environnement & Secrets (NE JAMAIS COMMITTER)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Conserver les templates d'environnement d'exemple
!.env.example
!.env.template

# Logs et rapports d'erreurs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Tests et couverture
coverage/
.nyc_output/
playwright-report/
test-results/

# Fichiers système (OS)
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDEs et éditeurs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Caches d'outils d'assistance et agents locaux
.claude/
.windsurf/
.devin/
